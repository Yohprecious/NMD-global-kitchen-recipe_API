{
  "entities": {
    "Recipe": {
      "title": "Recipe",
      "description": "A recipe for a Cameroonian meal.",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "description": "The name of the meal."
        },
        "description": {
          "type": "string",
          "description": "A brief description of the meal."
        },
        "ingredients": {
          "type": "array",
          "description": "List of ingredients needed."
        },
        "instructions": {
          "type": "string",
          "description": "Step-by-step cooking instructions."
        },
        "cookingTime": {
          "type": "number",
          "description": "Time in minutes to cook."
        },
        "difficulty": {
          "type": "string",
          "enum": ["Easy", "Medium", "Hard"],
          "description": "Difficulty level."
        },
        "category": {
          "type": "string",
          "enum": ["Breakfast", "Lunch", "Supper", "Brunch"],
          "description": "The type of meal."
        },
        "imageUrl": {
          "type": "string",
          "description": "URL to the meal image."
        },
        "videoUrl": {
          "type": "string",
          "description": "Path to the local video file."
        },
        "author": {
          "type": "string",
          "description": "The name of the person who shared the recipe (e.g., YOH PRECIOUS)."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["title", "ingredients", "instructions", "category"]
    }
  },
  "firestore": {
    "recipes": {
      "schema": "Recipe",
      "description": "Collection of all recipes."
    }
  }
}
